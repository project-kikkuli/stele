{
  "PreToolUse": [
    {
      "hooks": [
        {
          "command": "stele hook devin-cli pre-tool-use --scope repo",
          "type": "command"
        }
      ],
      "matcher": ""
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "command": "stele hook devin-cli session-start --scope repo",
          "type": "command"
        }
      ],
      "matcher": ""
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "command": "stele hook devin-cli stop --scope repo",
          "type": "command"
        }
      ],
      "matcher": ""
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "command": "stele hook devin-cli prompt --scope repo",
          "type": "command"
        }
      ],
      "matcher": ""
    }
  ]
}

{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "stele hook codex pre-tool-use --scope repo",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "stele hook codex session-start --scope repo",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "stele hook codex stop --scope repo",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "stele hook codex prompt --scope repo",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
